    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #2a2a2a;
            color: #fff;
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        .menu-icon {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 30px;
            cursor: pointer;
            z-index: 10;
        }

        .menu-icon div {
            width: 100%;
            height: 5px;
            background-color: white;
            margin: 6px 0;
        }

        .sliding-panel {
            position: fixed;
            top: 0;
            left: -250px;
            width: 250px;
            height: 100%;
            background-color: white;
            color: black;
            transition: 0.3s ease;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.5);
            z-index: 9;
            padding: 20px;
        }

        .sliding-panel a {
            display: block;
            padding: 10px;
            color: black;
            text-decoration: none;
            font-size: 18px;
            margin: 10px 0;
        }

        .sliding-panel a:hover {
            background-color: #f0f0f0;
        }

        .container {
            max-width: 500px;
            margin: 20px auto;
            background-color: #333;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        }

        .header {
            background-color: #858c00;
            padding: 15px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
        }

        .content {
            padding: 15px;
        }

        .content h3 {
            margin-top: 0;
            color: #ffc107;
        }

        .box {
            background-color: #8c7300;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            border: 1px solid #ffc107;
        }

        .box a {
            display: block;
            color: #fff;
            font-weight: bold;
            text-decoration: none;
            margin-bottom: 10px;
        }

        .box a:hover {
            color: #ffc107;
        }

        .statistics {
            background-color: #858c00;
            padding: 10px;
            text-align: center;
            border-radius: 0 0 8px 8px;
            border-top: 1px solid #ffc107;
        }

        /* Nouveau style pour l'overlay */
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5); /* Fond sombre transparent */
            z-index: 8;
            transition: opacity 0.3s ease;
        }

        .overlay.active {
            display: block;
        }

        .sliding-panel.inactive {
            left: -250px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sliding-panel.active {
            left: 0;
            opacity: 1;
        }
    </style>
</head>
<body>

<!-- Back Arrow Navigation -->
<style>
.global-back-btn {
    position: fixed;
    top: 14px;
    left: 14px;
    z-index: 99999;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    background: rgba(15, 23, 42, 0.92);
    color: #ffffff !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
}
.global-back-btn:hover {
    background: #0f172a;
    color: #38bdf8 !important;
    transform: translateX(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
}
@media (max-width: 640px) {
    .global-back-btn {
        top: 10px;
        left: 10px;
        padding: 6px 12px;
        font-size: 12px;
